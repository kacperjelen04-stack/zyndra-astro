---
import Layout from "../../layouts/Layout.astro";
import DeptHero from "../../components/baselinker/DeptHero.astro";
import FlowDiagram from "../../components/baselinker/FlowDiagram.astro";
import BulletSection from "../../components/baselinker/BulletSection.astro";
import CaseStudyPlaceholder from "../../components/baselinker/CaseStudyPlaceholder.astro";
import CTABanner from "../../components/baselinker/CTABanner.astro";
import RelatedLinks from "../../components/baselinker/RelatedLinks.astro";

const diagram = `    MAPOWANIE
        │
   ┌────┼────┐
   ▼    ▼    ▼
 SKU   EAN  PRODUKT
   │    │    │
   └────┼────┘
        ▼
   BASELINKER
        │
   ┌────┼────┐
   ▼    ▼    ▼
ALLEGRO ERLI EMPIK`;
---

<Layout
  title="Mapowanie SKU, EAN i produktów w BaseLinker | Zyndra"
  description="Jeden produkt może istnieć w kilku systemach pod różnymi identyfikatorami. Mapowanie SKU, EAN, wariantów i ofert między sklepem, BaseLinkerem i marketplace'ami."
>
  <DeptHero
    breadcrumb="BaseLinker → Mapowanie"
    title="Jeden produkt, kilka systemów, różne identyfikatory."
    quote="Jeden produkt może istnieć w kilku systemach pod różnymi identyfikatorami."
    lead="Bez poprawnego mapowania BaseLinker nie wie, że oferta na Allegro, produkt w sklepie i pozycja w ERP to ten sam towar — a to prosta droga do rozjeżdżających się stanów i cen."
  />

  <FlowDiagram diagram={diagram} />

  <BulletSection
    label="Zakres"
    title="Co obejmuje mapowanie"
    items={[
      "SKU",
      "EAN",
      "Warianty",
      "Produkty",
      "Oferty",
      "Kategorie",
      "Parametry",
      "Istniejące oferty",
      "Mapowanie automatyczne",
      "Mapowanie ręczne tam, gdzie konieczne",
    ]}
  />

  <CaseStudyPlaceholder />

  <CTABanner title="Zmapujmy Twój katalog raz, porządnie" />

  <RelatedLinks
    links={[
      { href: "/baselinker/", label: "← Cały dział BaseLinker" },
      { href: "/baselinker/katalog-produktow/", label: "Katalog produktów" },
      { href: "/baselinker/magazyny/", label: "Magazyny" },
      { href: "/baselinker/shoper/", label: "Shoper" },
    ]}
  />
</Layout>
