---
export interface Props {
  diagram: string;
  caption?: string;
}

const { diagram, caption } = Astro.props;
---

<section class="flow">
  <div class="flow__inner">
    <p class="section-label">Jak to działa</p>
    <div class="flow__box">
      <pre class="flow__ascii">{diagram}</pre>
    </div>
    {caption && <p class="flow__caption">{caption}</p>}
  </div>
</section>

<style>
  .flow {
    padding: 64px 24px;
    border-bottom: 1px solid var(--border);
  }
  .flow__inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .flow__box {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px 24px;
    overflow-x: auto;
  }
  .flow__ascii {
    font-family: "SF Mono", "Consolas", "Menlo", ui-monospace, monospace;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--accent);
    white-space: pre;
    margin: 0;
  }
  .flow__caption {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-top: 14px;
  }

  @media (max-width: 640px) {
    .flow__ascii { font-size: 0.68rem; }
  }
</style>
