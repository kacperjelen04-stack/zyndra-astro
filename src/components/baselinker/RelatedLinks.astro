---
export interface Link {
  href: string;
  label: string;
}

export interface Props {
  title?: string;
  links: Link[];
}

const { title = "Powiązane obszary", links } = Astro.props;
---

<section class="related">
  <div class="related__inner">
    <p class="section-label">{title}</p>
    <div class="related__grid">
      {links.map((link) => (
        <a class="related__link" href={link.href}>
          {link.label}
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .related {
    padding: 56px 24px 96px;
  }
  .related__inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .related__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .related__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 100px;
    border: 1px solid var(--border);
    color: var(--text-main);
    font-size: 0.88rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .related__link:hover {
    border-color: var(--border-accent);
    color: var(--accent);
  }
  .related__link svg { color: var(--accent); }
</style>
