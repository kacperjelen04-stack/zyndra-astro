---
export interface Item {
  title: string;
  description: string;
}

export interface Props {
  label?: string;
  title: string;
  intro?: string;
  items: Item[];
}

const { label = "Rozwiązanie", title, intro, items } = Astro.props;
---

<section class="solution">
  <div class="solution__inner">
    <p class="section-label">{label}</p>
    <h2 class="section-title">{title}</h2>
    {intro && <p class="section-sub">{intro}</p>}

    <div class="solution__grid">
      {items.map((item) => (
        <div class="solution-item">
          <span class="solution-item__marker" aria-hidden="true"></span>
          <h3 class="solution-item__title">{item.title}</h3>
          <p class="solution-item__desc">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .solution {
    padding: 88px 24px;
    border-top: 1px solid var(--border);
  }
  .solution__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .solution__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 44px;
  }
  .solution-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px;
  }
  .solution-item__marker {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--accent-dim);
    border: 1px solid var(--border-accent);
  }
  .solution-item__title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    margin-top: 16px;
    line-height: 1.4;
  }
  .solution-item__desc {
    color: var(--text-muted);
    font-size: 0.89rem;
    line-height: 1.7;
    margin-top: 10px;
  }
</style>
